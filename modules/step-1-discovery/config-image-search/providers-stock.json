{
  "config": "stock-imagery",
  "configures": "api-search",
  "version": "1.0.0",
  "description": "api-search provider preset for illustrative/stock imagery: Pixabay + Unsplash (query-param auth) and Pexels (custom-header auth, unblocked by api-search v1.1.0). Keyword-driven; every item carries image_url for step-8 company-media. NOT for entity-specific brand assets (that is the search-discovery images vertical + logo lookups). Pipeline-agnostic: put the search keywords in template config.",
  "search_input": "keywords",
  "keywords": ["abstract technology background"],
  "max_results": 5,
  "requests_per_minute": 20,
  "providers": [
    {
      "id": "pixabay",
      "name": "Pixabay",
      "mode": "search",
      "url": "https://pixabay.com/api/",
      "keyword_param": "q",
      "limit_param": "per_page",
      "results_path": "hits",
      "field_map": {
        "url": "pageURL",
        "image_url": "webformatURL",
        "title": "tags",
        "company": "user",
        "snippet": null,
        "externalId": "id",
        "postedAt": null
      },
      "auth": { "type": "query_param", "key": "key", "env_var": "PIXABAY_API_KEY" }
    },
    {
      "id": "unsplash",
      "name": "Unsplash",
      "mode": "search",
      "url": "https://api.unsplash.com/search/photos",
      "keyword_param": "query",
      "limit_param": "per_page",
      "results_path": "results",
      "field_map": {
        "url": "links.html",
        "image_url": "urls.regular",
        "title": "alt_description",
        "company": "user.name",
        "snippet": null,
        "externalId": "id",
        "postedAt": "created_at"
      },
      "auth": { "type": "query_param", "key": "client_id", "env_var": "UNSPLASH_ACCESS_KEY" }
    },
    {
      "id": "pexels",
      "name": "Pexels",
      "mode": "search",
      "url": "https://api.pexels.com/v1/search",
      "keyword_param": "query",
      "limit_param": "per_page",
      "results_path": "photos",
      "field_map": {
        "url": "url",
        "image_url": "src.large",
        "title": "alt",
        "company": "photographer",
        "snippet": null,
        "externalId": "id",
        "postedAt": null
      },
      "headers": { "Authorization": "{env:PEXELS_API_KEY}" }
    }
  ],
  "provider_params": {}
}
